---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>MangoMaverick's Project Page</h1>
			<p>
				There is currently nothing here to observe, but in the future, all side projects and main projects will be hosted here. An Art Portifolio, side projects, etc.
			</p>
		</main>
		<Footer />
	</body>
</html>
